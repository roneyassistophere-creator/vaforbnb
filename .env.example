# --------------------------------------------------------------------------
# Copy this file to .env and adjust. .env is git-ignored; never commit secrets.
# The defaults below work with `docker compose up` out of the box.
# --------------------------------------------------------------------------

# Which compose profile plain `docker compose up` starts:
#   (empty) database + storage only, run `npm run dev` yourself
#   dev     everything, site with hot reload
#   prod    everything, production build
COMPOSE_PROFILES=dev

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_PORT=3000

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=vaforbnb
POSTGRES_PASSWORD=vaforbnb
POSTGRES_DB=vaforbnb
POSTGRES_PORT=5432
# Used when running Next.js or drizzle-kit on your machine (not in Docker).
# Containers build their own URL from the values above.
# Live: your managed Postgres URL, e.g. postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgres://vaforbnb:vaforbnb@localhost:5432/vaforbnb

# ---- S3 storage -------------------------------------------------------------
# Local: SeaweedFS in Docker (S3-compatible).
# Live:  Cloudflare R2. Create a bucket and an R2 API token (Object Read & Write), then set
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_PUBLIC_ENDPOINT=                (leave empty: same as S3_ENDPOINT)
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID=<R2 access key id>
#   S3_SECRET_ACCESS_KEY=<R2 secret access key>
#   S3_BUCKET=<bucket name>
#   S3_FORCE_PATH_STYLE=true
#   S3_PUBLIC_URL=https://files.yourdomain.com   (optional: public bucket / custom domain)
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=localdev
S3_SECRET_ACCESS_KEY=localdev-secret
S3_BUCKET=vaforbnb
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=
S3_PORT=8333

# Local testing only: show SAMPLE events on the public event calendar (never works in production).
# Load them with: npm run db:seed:sample-events
EVENTS_SHOW_SAMPLE=
